# ── Environment ───────────────────────────────────────────────────────
ENV=dev

# ── Database ──────────────────────────────────────────────────────────
# Production uses postgres+asyncpg. Tests override with sqlite+aiosqlite.
DATABASE_URL=postgresql+asyncpg://skillsgit:skillsgit@localhost:5432/skillsgit

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (MinIO locally, R2 in prod) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=skillsgit
S3_SECRET_KEY=skillsgit
S3_BUCKET=skillsgit-skills

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── Secrets ───────────────────────────────────────────────────────────
# Both MUST be replaced before production. Each must be >= 32 chars random.
JWT_SECRET=dev-jwt-secret-change-me-please-32+chars
PLATFORM_HMAC_KEY=dev-hmac-key-change-me-please-32+chars

# ── Platform economics ────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=20.0

# ── Email (Mailhog locally) ───────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@skillsgit.local

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for cookie-bearing requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── OAuth (optional; Phase 1) ─────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── AI providers (optional; Phase 3+ sandbox) ─────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Capture LLM (ADR-008) ─────────────────────────────────────────────
# Platform-managed Claude key drives the capture flow's draft extraction
# job. ``SKG_CAPTURE_LLM_STUB=1`` swaps in tests/stubs/llm.py for CI;
# ``SKG_CAPTURE_QUOTA_PER_MONTH`` caps free-tier captures per creator.
SKG_CAPTURE_LLM_MODEL=claude-sonnet-4-6
SKG_CAPTURE_LLM_STUB=0
SKG_CAPTURE_QUOTA_PER_MONTH=10

# ── Build info ────────────────────────────────────────────────────────
GIT_COMMIT=dev

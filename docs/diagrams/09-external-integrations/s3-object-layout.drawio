        <mxCell id="n-BE1" value="BE1: S3Storage (storage/s3.py)&#10;aioboto3 wrapper; same code&#10;against MinIO (dev) and R2/S3 (prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">

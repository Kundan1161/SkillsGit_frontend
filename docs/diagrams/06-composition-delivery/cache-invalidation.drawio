<mxfile host="app.diagrams.net" agent="skillsgit-arch" version="24.7.17" type="device">
  <diagram name="cache-invalidation" id="skg-cache-inval">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Composed-bundle cache lifecycle — Redis (or in-mem in tests)&#10;Source: apps/api/src/vault/composer.py + apps/api/src/core/cache.py — ADR-006 (24h cache, 60s presigned URL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1800" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="g-key" value="Cache key derivation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="780" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="n-k1" value="K1: buyer_id&#10;(UUID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n-k2" value="K2: occupation_skill_id&#10;(UUID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="130" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n-k3" value="K3: occupation_build_id&#10;(UUID — latest succeeded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="130" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n-k4" value="K4: sorted(persona_build_ids)&#10;(list[UUID] — latest succeeded each)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="600" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n-k5" value="K5: payload = '|'.join([&#10;str(buyer_id), str(occ_skill_id),&#10;str(occ_build_id), *sorted_pids])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="600" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-k6" value="K6: digest = sha256(payload).hexdigest()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="600" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n-k7" value="K7: cache_key =&#10;composed:{buyer_id}:{occ_skill_id}:{digest}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="600" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="g-hot" value="Hot path — cache HIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="900" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="n-h1" value="H1: POST /v1/licenses/{id}/vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-h2" value="H2: composer.compose_for_license" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-h3" value="H3: cache.get_or_compute(cache_key, …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="270" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-h4" value="H4: Redis GET cache_key → JSON payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="340" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-h5" value="H5: payload = {storage_url,&#10;composed_hash, vault_download_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="410" width="380" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n-h6" value="H6: storage.presigned_url(&#10;storage_url, ttl=60s)&#10;(URL is fresh every call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1300" y="200" width="440" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-h7" value="H7: Return ComposedDownload(&#10;cache_hit=True, …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="320" width="440" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="g-cold" value="Cold path — cache MISS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1720" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="n-c1" value="C1: POST /v1/licenses/{id}/vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-c2" value="C2: composer.compose_for_license" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="710" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-c3" value="C3: cache.get_or_compute&#10;→ no entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="700" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n-c4" value="C4: _compute() = _build_and_record:&#10;read every input zip from S3&#10;merge persona subtrees&#10;regenerate vault.json&#10;watermark every .md&#10;deterministic re-zip&#10;upload to delivery/vaults/{nonce}.zip&#10;INSERT vault_downloads row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1040" y="690" width="340" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="n-c5" value="C5: payload = {storage_url,&#10;composed_hash, vault_download_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1400" y="690" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-c6" value="C6: cache.SETEX cache_key&#10;ttl=86400 (24h)&#10;value = json.dumps(payload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="420" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-c7" value="C7: storage.presigned_url(&#10;storage_url, ttl=60s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="900" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-c8" value="C8: Return ComposedDownload(&#10;cache_hit=False, …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="900" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="g-inv" value="Natural invalidation — new build → new key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1210" width="1280" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="n-n1" value="N1: Creator publishes occupation v1.0.1&#10;via POST /v1/occupations/{id}/build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#be185d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1250" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-n2" value="N2: vault.jobs.build_occupation_job&#10;writes new vault_builds row&#10;(new build_id; old row stays)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#be185d;" vertex="1" parent="1">
          <mxGeometry x="320" y="1250" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-n3" value="N3: _latest_succeeded_build now returns&#10;the new build_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#be185d;" vertex="1" parent="1">
          <mxGeometry x="580" y="1250" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-n4" value="N4: cache_key derivation pulls&#10;the new build_id → new digest&#10;→ new cache_key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#be185d;" vertex="1" parent="1">
          <mxGeometry x="840" y="1250" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-n5" value="N5: Old entry (under old cache_key)&#10;just ages out at 24h TTL.&#10;No explicit invalidation needed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#be185d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1360" width="1020" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="g-manual" value="Manual invalidation &lt;&lt;deferred&gt;&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1210" width="640" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="n-m1" value="M1: cache.invalidate(key) exists&#10;(core/cache.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1250" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-m2" value="M2: Currently unused — no creator-side&#10;rebuild webhook fires invalidations.&#10;Cycle 2: creator emergency 'rebuild now'&#10;UI calls invalidate over a key range." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1680" y="1250" width="300" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="g-iso" value="Per-buyer isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1520" width="1280" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n-iso1" value="ISO1: buyer_id is in the cache key.&#10;Two different buyers composing&#10;the SAME (occ_build, persona_build)&#10;set produce DIFFERENT keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="1560" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n-iso2" value="ISO2: This is intentional — the cached&#10;storage_url points at a watermarked&#10;bundle. Buyer A's bundle MUST NOT&#10;be returned to Buyer B." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="460" y="1560" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n-iso3" value="ISO3: Cache eviction is per-key; no risk&#10;of cross-buyer leakage from cache&#10;state alone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="860" y="1560" width="380" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="g-be" value="Backend selection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1520" width="640" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n-be1" value="BE1: core/cache.py:_use_inmem()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1560" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n-be2" value="BE2: settings.is_test == True&#10;OR SKG_CACHE_INMEM=1&#10;→ process-local dict&#10;(honours TTL on read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1630" width="290" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n-be3" value="BE3: Otherwise → redis.asyncio&#10;via REDIS_URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1690" y="1630" width="290" height="120" as="geometry"/>
        </mxCell>


        </mxCell>

        <!-- Notes -->
        <mxCell id="notes" value="Notes&#10;• Attribution comment is MULTI-LINE YAML inside an HTML comment.&#10;• Watermark is SINGLE-LINE per delivery/watermark.append_watermark.&#10;• Both are HTML comments — markdown renderers treat them as no-ops.&#10;• hmac_id() yields first 16 hex chars of HMAC-SHA256 keyed by&#10;  settings.PLATFORM_HMAC_KEY; raw uuids never appear in watermarks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1900" height="160" as="geometry"/>
        </mxCell>


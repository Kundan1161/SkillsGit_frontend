        <mxCell id="n-ST4" value="ST4: attachments/captures/ — capture-time uploads&#10;(per capture_session_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">

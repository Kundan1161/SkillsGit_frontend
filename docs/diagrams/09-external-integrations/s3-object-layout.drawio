        <mxCell id="n-ST5" value="ST5: attachments/personas/ — post-finalize copies&#10;(per persona_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1920" width="1300" height="55" as="geometry"/>

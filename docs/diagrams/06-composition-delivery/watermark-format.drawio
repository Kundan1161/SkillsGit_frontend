<mxfile host="app.diagrams.net" agent="skillsgit-arch" version="24.7.17" type="device">
  <diagram name="watermark-format" id="skg-wm-format">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Per-buyer watermark format — single-line HTML comment appended to every .md inside a delivered bundle&#10;Source: apps/api/src/delivery/watermark.py + apps/api/src/vault/composer.py:_stamp_markdown_with_watermark — ADR-010 (HMAC-keyed forensic ids)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2400" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n-fileTop" value="A delivered .md file (e.g. domains/ci-cd/ci-pipeline-architect.md)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0EA5E9;strokeColor=#0369A1;fontColor=#FFFFFF;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="700" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== File stack ===== -->
        <mxCell id="g-stack" value="File contents (top → bottom)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="700" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="n-F1" value="F1: --- YAML frontmatter ---&#10;(creator-authored; immutable per release)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="660" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-F2" value="F2: body markdown&#10;(creator-authored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="660" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-F3" value="F3: ## Linked notes&#10;(builder-injected at build time)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="660" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-F4" value="F4: &lt;!-- skg-attribution: ... --&gt;&#10;(builder-injected at build time;&#10;pinned to EPOCH_DATETIME for determinism)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="660" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-F5" value="F5: &lt;!-- license:8f3a1c4d2b6e9011&#10;     buyer:9b4d2e7a1c3f5808&#10;     ts:2026-05-26T18:30:42Z --&gt;&#10;(composer-injected at compose time;&#10;FRESH wall-clock per call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="660" height="200" as="geometry"/>
        </mxCell>

        <!-- ===== Watermark shape ===== -->
        <mxCell id="g-wm" value="Watermark line — shape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="190" width="900" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="n-WM1" value="WM1: Format string (literal, one line):&#10;&lt;!-- license:HMAC16 buyer:HMAC16 ts:ISO8601-Z --&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="230" width="860" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-WM2" value="WM2: license: first 16 hex of&#10;HMAC-SHA256(license_id,&#10;settings.PLATFORM_HMAC_KEY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="800" y="350" width="860" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-WM3" value="WM3: buyer: first 16 hex of&#10;HMAC-SHA256(buyer_id,&#10;settings.PLATFORM_HMAC_KEY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="800" y="470" width="860" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-WM4" value="WM4: ts: datetime.now(UTC).isoformat()&#10;with '+00:00' rewritten to 'Z'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="800" y="590" width="860" height="100" as="geometry"/>
        </mxCell>

        <!-- ===== Injection ===== -->
        <mxCell id="g-inj" value="Where the watermark is injected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="190" width="820" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="n-I1" value="I1: vault/composer.py&#10;_stamp_markdown_with_watermark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1740" y="230" width="780" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-I2" value="I2: For every path ending in .md:&#10;decode utf-8 → append_watermark()&#10;→ encode utf-8 → re-stuff into zip dict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1740" y="350" width="780" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-I3" value="I3: Append-only: body.rstrip('\n') +&#10;'\n\n' + comment + '\n'&#10;(strict spacing: blank line before,&#10;single newline after)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1740" y="470" width="780" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n-I4" value="I4: Existing &lt;!-- skg-attribution: --&gt;&#10;is NOT touched — the watermark&#10;stacks below it. Spec §7 ordering&#10;is preserved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1740" y="610" width="780" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== Stability ===== -->
        <mxCell id="g-stab" value="Bytewise stability across buyers (same build set)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1640" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="n-S1" value="S1: Skill bodies (creator-authored):&#10;BYTE-IDENTICAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="930" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-S2" value="S2: Builder attribution comment (F4):&#10;BYTE-IDENTICAL&#10;(pinned to EPOCH_DATETIME)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="930" width="540" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-S3" value="S3: vault.json:&#10;differs only in composed_at + composed_hash&#10;(rest is byte-identical for same build set)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1140" y="930" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n-S4" value="S4: Per-buyer watermark (F5):&#10;DIFFERS per buyer (HMAC ids)&#10;+ per call (fresh wall-clock ts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1090" width="700" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n-S5" value="S5: zip envelope:&#10;BYTE-IDENTICAL ordering&#10;(_write_zip sorts paths,&#10;pins ZipInfo.date_time to EPOCH_TIMESTAMP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="1090" width="880" height="140" as="geometry"/>
        </mxCell>

        <!-- ===== Forensics ===== -->
        <mxCell id="g-fx" value="Leak forensics (server-side only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1310" width="1640" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="n-FX1" value="FX1: A leaked .md surfaces externally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1360" width="1600" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n-FX2" value="FX2: Extract HMAC16(license) +&#10;HMAC16(buyer) from the trailing comment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="1460" width="1600" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-FX3" value="FX3: Server replays hmac_id(L)&#10;over every License row&#10;(keyed by PLATFORM_HMAC_KEY)&#10;→ unique match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="1580" width="1600" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n-FX4" value="FX4: Cross-check HMAC16(buyer)&#10;against the matched License's&#10;buyer_id → confirms identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="1700" width="1600" height="80" as="geometry"/>
        </mxCell>


        <mxCell id="note-6" value="Stripe SDK verifies HMAC-SHA256 over (timestamp + '.' + body) using the webhook secret. Also checks timestamp tolerance (5 min default)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">

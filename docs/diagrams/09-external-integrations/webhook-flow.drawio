        </mxCell>
        <mxCell id="msg-41" value="41. row.status stays RECEIVED (processed_at = NULL)" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;curved=1;" edge="1" parent="1" source="p-service" target="p-service">
          <mxGeometry relative="1" as="geometry">

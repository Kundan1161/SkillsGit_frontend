        <mxCell id="note-1" value="Headers — Content-Type: application/json — Stripe-Signature: t=unix_ts, v1=HMAC-SHA256, v0=..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">

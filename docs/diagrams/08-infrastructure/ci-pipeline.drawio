        <mxCell id="title" value="GitHub Actions workflows — .github/workflows/&#10;Two workflows in Cycle 1: ci.yml (per-PR lint + typecheck + test + build) and team-smoke.yml (nightly + path-filtered integration smoke)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">

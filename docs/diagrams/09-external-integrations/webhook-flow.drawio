            <mxPoint x="790" y="2776" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="910" y="2746"/>
              <mxPoint x="910" y="2776"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-12" value="Stripe gets 200 anyway — Cycle-2 handlers will pick these up by re-querying RECEIVED rows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="692" y="2786" width="196" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="msg-42" value="42. UPDATE webhook_events SET status=PROCESSED, processed_at=now" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="p-service" target="p-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="2868" as="sourcePoint"/>
            <mxPoint x="1010" y="2868" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-13" value="If a handler raises — 1. service catches, sets row.status=FAILED + error=ExcName. 2. session.flush. 3. RE-RAISES so the router returns 5xx. 4. Router rolls back business writes, commits the failure row, then raises webhooks.handler_error (500). 5. Stripe retries per its exponential-backoff policy. (Idempotency at INSERT layer ensures retries are safe.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="692" y="2908" width="416" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="msg-43" value="43. session.commit()" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="p-router" target="p-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="2968" as="sourcePoint"/>
            <mxPoint x="1010" y="2968" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-44" value="44. 200 OK (deduped, event_id, type, handled, status)" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="p-router" target="p-stripe">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="3008" as="sourcePoint"/>
            <mxPoint x="130" y="3008" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-14" value="Failure modes summary — 400 missing_signature or invalid_payload — 401 invalid_signature — 500 handler_error so Stripe retries — 200 success or unhandled-but-acked (Stripe done). Stripe's retry policy: exponential backoff up to 3 days. Every handler is idempotent at the DB INSERT layer (stripe_payment_intent_id is unique on orders, webhook_events.id PK dedups before dispatch)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="32" y="3048" width="1296" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

<mxfile host="app.diagrams.net" agent="skillsgit-arch" version="24.7.17" type="device">
  <diagram name="Capture state machine" id="capture-state-machine-skillsgit">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="CaptureSession lifecycle&#10;Source: apps/api/src/capture/models.py (CaptureSessionStatus) + alembic 0008" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="60" as="geometry" />
        </mxCell>

        <!-- Start state (filled circle) -->
        <mxCell id="state-start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- draft -->
        <mxCell id="state-draft" value="draft&#10;━━━━━━&#10;Creator is editing&#10;situation / decision /&#10;outcome / context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="220" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- extracting (active state) -->
        <mxCell id="state-extracting" value="extracting&#10;━━━━━━&#10;LLM job in flight&#10;(stub or Arq worker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="420" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- draft_ready -->
        <mxCell id="state-draft-ready" value="draft_ready&#10;━━━━━━&#10;draft_md + suggested_links&#10;+ pii_flags persisted;&#10;creator reviews/edits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- finalizing (reserved enum, not used by current code) -->
        <mxCell id="state-finalizing" value="finalizing&#10;━━━━━━&#10;(reserved enum&#10;value — current&#10;code skips this)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=2;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="420" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- finalized (terminal success) -->
        <mxCell id="state-finalized" value="finalized&#10;━━━━━━&#10;Skill (kind=memory_neuron) +&#10;SkillVersion + PersonaNeuron&#10;committed in one tx (ADR-015)&#10;finalized_at, finalized_neuron_skill_id set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="640" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- abandoned (terminal failure) -->
        <mxCell id="state-abandoned" value="abandoned&#10;━━━━━━&#10;abandoned_at set;&#10;quota refund applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="660" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- End state (ringed circle) success -->
        <mxCell id="state-end-success" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="740" y="860" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="state-end-success-ring" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="730" y="850" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- End state abandoned -->
        <mxCell id="state-end-abandoned" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="180" y="860" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="state-end-abandoned-ring" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="170" y="850" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Transitions ===== -->
        <!-- [*] → draft -->
        <mxCell id="tr-1" value="POST /v1/capture/sessions&#10;(create_session)" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="state-start" target="state-draft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- draft → draft (self) -->
        <mxCell id="tr-2" value="PATCH /v1/capture/sessions/{id}&#10;(edit situation/decision/outcome/context)" style="endArrow=classic;html=1;rounded=0;curved=1;fontSize=11;" edge="1" parent="1" source="state-draft" target="state-draft">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="180" />
              <mxPoint x="700" y="230" />
              <mxPoint x="640" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- draft → extracting -->
        <mxCell id="tr-3" value="POST .../extract&#10;(enqueue_extract → run_extract)" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="state-draft" target="state-extracting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- extracting → draft_ready (success) -->
        <mxCell id="tr-4" value="Arq job writes draft_md,&#10;suggested_links, pii_flags, llm_model" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeColor=#065F46;" edge="1" parent="1" source="state-extracting" target="state-draft-ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- extracting → draft_ready (LLM error) -->
        <mxCell id="tr-5" value="llm.LLMExtractError raised&#10;(quota refunded, draft_md=None,&#10; capture.extract_parse_error)" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeColor=#b91c1c;dashed=1;" edge="1" parent="1" source="state-extracting" target="state-draft-ready">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="540" />
              <mxPoint x="640" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- draft_ready → draft_ready (self) -->
        <mxCell id="tr-6" value="PATCH (creator edits draft_md /&#10;resolves pii flags / accepts links)" style="endArrow=classic;html=1;rounded=0;curved=1;fontSize=11;" edge="1" parent="1" source="state-draft-ready" target="state-draft-ready">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="380" />
              <mxPoint x="960" y="430" />
              <mxPoint x="900" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- draft_ready → extracting (re-run) -->
        <mxCell id="tr-7" value="POST .../extract&#10;(re-run; consumes quota again)" style="endArrow=classic;html=1;rounded=0;fontSize=11;dashed=1;" edge="1" parent="1" source="state-draft-ready" target="state-extracting">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="380" />
              <mxPoint x="400" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- draft_ready → finalized -->
        <mxCell id="tr-8" value="POST .../finalize&#10;(finalize_session — atomic transaction)" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeColor=#065F46;strokeWidth=2;" edge="1" parent="1" source="state-draft-ready" target="state-finalized">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- abandoned transitions -->
        <mxCell id="tr-9" value="POST .../abandon" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeColor=#999999;" edge="1" parent="1" source="state-draft" target="state-abandoned">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr-10" value="POST .../abandon" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeColor=#999999;" edge="1" parent="1" source="state-extracting" target="state-abandoned">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr-11" value="POST .../abandon" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeColor=#999999;" edge="1" parent="1" source="state-draft-ready" target="state-abandoned">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="600" />
              <mxPoint x="300" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- terminal arrows -->
        <mxCell id="tr-12" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#065F46;strokeWidth=2;" edge="1" parent="1" source="state-finalized" target="state-end-success-ring">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr-13" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="state-abandoned" target="state-end-abandoned-ring">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Notes ===== -->
        <mxCell id="note-finalized" value="Finalize semantics&#10;━━━━━━━━━━━━&#10;Sets finalized_at + finalized_neuron_skill_id.&#10;Creates Skill (kind=memory_neuron) + SkillVersion&#10;+ PersonaNeuron rows inside one DB transaction&#10;(ADR-015).&#10;Re-runs pii.scan + validate_file. On any failure&#10;the SAVEPOINT rolls back and the row stays in&#10;DRAFT_READY (no state flip)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="600" width="420" height="180" as="geometry" />
        </mxCell>

        <mxCell id="note-extract" value="Quota gate&#10;━━━━━━━━━━━━&#10;Runs at the boundary DRAFT/DRAFT_READY → EXTRACTING.&#10;On 429 the row stays in its prior state&#10;(capture.quota_exceeded) — no state transition,&#10;no quota consumption.&#10;Quota is refunded on LLMExtractError and on abandon&#10;during extracting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="380" width="420" height="180" as="geometry" />
        </mxCell>

        <mxCell id="note-finalizing" value="finalizing — reserved enum value&#10;━━━━━━━━━━━━&#10;Not used by current code; the service&#10;implementation flips DRAFT_READY → FINALIZED directly.&#10;Future split: hold the row in FINALIZING while&#10;attachment S3 copies run, then commit the tx.&#10;This lets long-running finalize jobs surface a&#10;distinct progress state to the UI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1180" y="160" width="420" height="180" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend&#10;━━━━━━━━━━━━&#10;● initial pseudo-state&#10;◎ terminal pseudo-state&#10;Blue   intermediate (draft / draft_ready)&#10;Yellow active   (extracting)&#10;Green  terminal success (finalized)&#10;Grey   terminal failure (abandoned) / reserved&#10;Dashed transition = error or quota-consuming re-run&#10;Bold green edge = success finalize path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="500" height="220" as="geometry" />
        </mxCell>

        <!-- Status enum reference -->
        <mxCell id="enum-ref" value="CaptureSessionStatus enum (alembic 0008)&#10;━━━━━━━━━━━━&#10;'draft'         — creator-editable input fields&#10;'extracting'    — LLM job in flight (Arq or stub)&#10;'draft_ready'   — LLM output reviewed by creator&#10;'finalizing'    — RESERVED (not yet used by code)&#10;'finalized'     — neuron published; row immutable&#10;'abandoned'     — quota refunded; row immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="980" width="500" height="220" as="geometry" />
        </mxCell>

        <!-- HTTP routes summary -->
        <mxCell id="routes" value="HTTP routes (capture/router.py)&#10;━━━━━━━━━━━━&#10;POST   /v1/capture/sessions                   → create &amp; enter DRAFT&#10;PATCH  /v1/capture/sessions/{id}              → DRAFT or DRAFT_READY edit&#10;POST   /v1/capture/sessions/{id}/extract      → enqueue Arq extract_neuron&#10;POST   /v1/capture/sessions/{id}/finalize     → finalize_session (atomic)&#10;POST   /v1/capture/sessions/{id}/abandon      → set abandoned_at&#10;POST   /v1/capture/sessions/{id}/attachments  → upload (DRAFT/DRAFT_READY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="980" width="640" height="220" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

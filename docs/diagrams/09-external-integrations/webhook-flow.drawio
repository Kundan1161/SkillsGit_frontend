        </mxCell>
        <mxCell id="note-5" value="400 webhooks.missing_signature if Stripe-Signature absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">

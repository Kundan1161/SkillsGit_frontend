%% Attribution + watermark comment format inside every delivered .md.
%% Source: apps/api/src/vault/builder.py:_emit_attribution_comment
%%         apps/api/src/delivery/watermark.py:append_watermark
%%         apps/api/src/vault/composer.py:_stamp_markdown_with_watermark

graph TB
    fileRoot["Every delivered .md file"]

    subgraph layers["File layout (top to bottom)"]
        L1["--- YAML frontmatter ---<br/>(authored by the skill creator)<br/>kind, version, links, tags, neuron block, ..."]
        L2["body markdown<br/>## When to use, ## How to apply, ...<br/>(authored by the skill creator)"]
        L3["## Linked notes<br/>- [[domains/observability/observability-dashboard-architect]] — see-also<br/>- [[domains/ci-cd/ci-pipeline-architect]] — applies<br/>(auto-generated by vault/builder._emit_linked_notes_section<br/>from frontmatter links list)"]
        L4["HTML comment: skg-attribution<br/>  vault_path: domains/ci-cd/ci-pipeline-architect.md<br/>  skill_id: 01HX-...<br/>  version: 1.0.1<br/>  kind: skill<br/>  creator_handle: skillsgit-curated<br/>  content_hash: abc123...<br/>  built_at: 2026-01-01T00:00:00Z<br/>(emitted by vault/builder._emit_attribution_comment at BUILD time<br/>— pinned to EPOCH_DATETIME for determinism)"]
        L5["HTML comment: license:8f3a1c... buyer:9b4d2e... ts:2026-05-26T18:30:42Z<br/>(emitted by delivery/watermark.append_watermark at COMPOSE time<br/>— fresh wall-clock per call; HMAC-hashed ids never leak raw uuids)"]
    end

    fileRoot --> L1
    L1 --> L2
    L2 --> L3
    L3 --> L4
    L4 --> L5

    subgraph emit["Where each block is emitted"]
        E1["Skill creator writes 1 + 2<br/>during authoring; immutable per release"]
        E2["Builder emits 3 + 4<br/>vault/builder.py _emit_file_body<br/>once per (skill_id, content_hash)"]
        E3["Composer emits 5<br/>vault/composer.py _stamp_markdown_with_watermark<br/>once per buyer per compose call"]
    end

    L1 -. "creator" .-> E1
    L2 -. "creator" .-> E1
    L3 -. "builder" .-> E2
    L4 -. "builder" .-> E2
    L5 -. "composer" .-> E3

    classDef body fill:#FEF3C7,color:#92400E,stroke:#B45309;
    classDef linkednotes fill:#D1FAE5,color:#065F46,stroke:#059669;
    classDef attr fill:#DBEAFE,color:#1E40AF,stroke:#1D4ED8;
    classDef wm fill:#FCE7F3,color:#9D174D,stroke:#BE185D;
    classDef root fill:#0EA5E9,color:#fff,stroke:#0369A1;
    classDef emitter fill:#F1F5F9,color:#334155,stroke:#475569;

    class fileRoot root;
    class L1,L2 body;
    class L3 linkednotes;
    class L4 attr;
    class L5 wm;
    class E1,E2,E3 emitter;

    %% Notes:
    %% - Attribution comment is MULTI-LINE YAML inside an HTML comment.
    %% - Watermark is SINGLE-LINE per delivery/watermark.append_watermark.
    %% - Both are HTML comments — markdown renderers treat them as no-ops.
    %% - hmac_id() yields first 16 hex chars of HMAC-SHA256 keyed by
    %%   settings.PLATFORM_HMAC_KEY; raw uuids never appear in watermarks.

<mxfile host="app.diagrams.net" agent="skillsgit-arch" version="24.7.17" type="device">
  <diagram name="ER skills core" id="er-skills-core-skillsgit">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Skills core ER — pre-Cycle-1 spine + kind discriminator&#10;Source: apps/api/src/{users,skills,catalog}/models.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="60" as="geometry" />
        </mxCell>

        <!-- Identity cluster -->
        <mxCell id="g-identity" value="Identity" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="540" height="320" as="geometry" />
        </mxCell>
        <mxCell id="tbl-users" value="users&#10;━━━━━━━━━━━━&#10;id (PK)&#10;email (UK, citext)&#10;hashed_password&#10;role (buyer|creator|admin)&#10;is_admin&#10;payouts_enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tbl-creator-profiles" value="creator_profiles&#10;━━━━━━━━━━━━&#10;id (PK)&#10;user_id (FK,UK)&#10;handle (UK, citext)&#10;bio&#10;industries (text[])&#10;payout_country (char(2))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="240" height="200" as="geometry" />
        </mxCell>

        <!-- Catalog cluster -->
        <mxCell id="g-catalog" value="Catalog" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="300" height="320" as="geometry" />
        </mxCell>
        <mxCell id="tbl-categories" value="categories&#10;━━━━━━━━━━━━&#10;slug (PK, citext)&#10;name&#10;parent_slug (FK, self)&#10;display_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="140" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend&#10;━━━━━━━━━━━━&#10;Identity (blue)&#10;Catalog (yellow)&#10;Skills spine (green)&#10;━━━━━━━━━━━━&#10;PK  primary key&#10;FK  foreign key&#10;UK  unique key&#10;||--o{  one-to-many&#10;||--o|  one-to-zero-or-one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="260" height="240" as="geometry" />
        </mxCell>

        <!-- Skills spine -->
        <mxCell id="g-skills" value="Skills spine (kind discriminator = Cycle-1 add)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1200" height="500" as="geometry" />
        </mxCell>
        <mxCell id="tbl-skills" value="skills&#10;━━━━━━━━━━━━&#10;id (PK)&#10;creator_id (FK → users)&#10;slug (citext, UK per creator)&#10;name&#10;tagline&#10;description_md&#10;kind (skill|occupation|persona|memory_neuron)&#10;   ← Cycle-1 enum&#10;status (draft|pending_review|published|unlisted|removed)&#10;pricing_model (free|one_time|subscription|freemium)&#10;category (FK → categories)&#10;tags (text[])&#10;latest_version_id (FK → skill_versions, use_alter)&#10;one_time_price_cents&#10;subscription_price_cents&#10;total_sales&#10;rating_avg (numeric)&#10;rating_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="tbl-skill-versions" value="skill_versions&#10;━━━━━━━━━━━━&#10;id (PK)&#10;skill_id (FK → skills)&#10;version (semver, UK per skill)&#10;content_hash (char(64), sha256)&#10;storage_url (S3 key)&#10;ai_requirements (jsonb)&#10;changelog_md&#10;released_at (timestamptz)&#10;is_yanked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="320" height="260" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="notes" value="Notes&#10;• kind enum is the ONLY Cycle-1 column visible here (migration 0006).&#10;• Side-tables for occupations/personas live in er-cycle1-extensions.drawio.&#10;• Pricing/billing logic routes identically across all four kinds (ADR-004).&#10;• latest_version_id uses use_alter to break the circular dependency.&#10;• skill_versions.released_at + is_yanked drive the &quot;frozen on release&quot; semantics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="500" width="600" height="160" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="rel-1" value="owns (1:0..1)" style="endArrow=ERoneToOne;startArrow=ERone;edgeStyle=entityRelationEdgeStyle;strokeColor=#6c8ebf;html=1;" edge="1" parent="1" source="tbl-users" target="tbl-creator-profiles">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-2" value="is creator of" style="endArrow=ERmany;startArrow=ERone;edgeStyle=entityRelationEdgeStyle;strokeColor=#6c8ebf;html=1;" edge="1" parent="1" source="tbl-users" target="tbl-skills">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-3" value="primary category" style="endArrow=ERmany;startArrow=ERone;edgeStyle=entityRelationEdgeStyle;strokeColor=#d6b656;html=1;" edge="1" parent="1" source="tbl-categories" target="tbl-skills">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-4" value="parent_slug self-FK" style="endArrow=ERmany;startArrow=ERone;edgeStyle=entityRelationEdgeStyle;strokeColor=#d6b656;curved=1;html=1;" edge="1" parent="1" source="tbl-categories" target="tbl-categories">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="120" />
              <mxPoint x="760" y="120" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rel-5" value="versions (frozen on release)" style="endArrow=ERmany;startArrow=ERone;edgeStyle=entityRelationEdgeStyle;strokeColor=#82b366;html=1;" edge="1" parent="1" source="tbl-skills" target="tbl-skill-versions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-6" value="latest_version_id (use_alter FK)" style="endArrow=ERoneToOne;startArrow=ERone;edgeStyle=entityRelationEdgeStyle;strokeColor=#82b366;dashed=1;html=1;" edge="1" parent="1" source="tbl-skills" target="tbl-skill-versions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

              <mxPoint x="470" y="390"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-3" value="raw bytes — DO NOT json-parse before HMAC verify, the signature covers the raw bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">

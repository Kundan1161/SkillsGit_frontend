        <mxCell id="note-7" value="After 60s the presigned URL is dead. Buyer POSTs the endpoint again → cache HIT (within 24h) and a fresh 60s URL is minted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
